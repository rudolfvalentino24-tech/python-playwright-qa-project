# Copy this file to test_hub/.env and replace placeholder secrets locally.
# test_hub/.env is ignored by Git and must never be committed.

# Test Hub
TEST_HUB_BASE_URL=http://127.0.0.1:3000
TEST_HUB_API_KEY=replace-with-the-same-secret-used-by-jenkins
SECRET_KEY=replace-with-a-local-flask-secret

# Jira Cloud
JIRA_SITE_URL=https://qa-test-store.atlassian.net
JIRA_PROJECT_KEY=SCRUM
JIRA_EMAIL=your-atlassian-login-email
JIRA_API_TOKEN=replace-with-your-jira-api-token

# Jenkins
JENKINS_URL=http://127.0.0.1:8080
JENKINS_JOB_NAME=PythonPlaywrightTest
JENKINS_USER=rudolfvalentin
JENKINS_API_TOKEN=replace-with-your-jenkins-api-token

# OpenAI API
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
